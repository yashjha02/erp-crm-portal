# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL connection string)
# Local example:      postgresql://postgres:postgres@localhost:5432/erp_crm?schema=public
# Neon/Supabase/Render example is provided by the hosting dashboard
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_crm?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# CORS - comma separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"
